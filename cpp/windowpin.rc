// WindowPinLite 资源脚本
// 编译：rc /nologo /fo windowpin.res windowpin.rc
// 图标 = Segoe UI Emoji U+1F4CC（📌）渲染结果，见 make_assets.py
// 版本号来自 version.h（由 build.bat 从 VERSION.txt 生成），不要在此硬编码

#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
#include "version.h"

IDI_APPICON ICON "assets/windowpin.ico"

// 版本信息
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_MAJOR,VER_MINOR,VER_PATCH,VER_BUILD
 PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,VER_BUILD
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "WindowPinLite"
            VALUE "FileDescription",  "WindowPinLite - 窗口置顶小工具"
            VALUE "FileVersion",      VER_STRING
            VALUE "InternalName",     "WindowPinLite"
            VALUE "OriginalFilename", VER_FILENAME
            VALUE "ProductName",      "WindowPinLite"
            VALUE "ProductVersion",   VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
